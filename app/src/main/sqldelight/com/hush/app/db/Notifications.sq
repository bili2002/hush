-- SQLite 3.18 (minSdk 26): no UPSERT / window functions / RETURNING.
CREATE TABLE notification_event (
    id TEXT NOT NULL PRIMARY KEY,
    key TEXT NOT NULL,
    package_name TEXT NOT NULL,
    app_label TEXT,
    post_time INTEGER NOT NULL,
    title TEXT,
    text TEXT,
    big_text TEXT,
    sub_text TEXT,
    channel_id TEXT,
    category TEXT,
    flags INTEGER NOT NULL,
    importance INTEGER,
    event TEXT NOT NULL,
    removed_reason INTEGER,
    held INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    delivered_at INTEGER,
    synced_at INTEGER,
    created_at INTEGER NOT NULL
);

CREATE INDEX notification_event_post_time ON notification_event(post_time);
CREATE INDEX notification_event_package_post_time ON notification_event(package_name, post_time);
CREATE INDEX notification_event_unsynced ON notification_event(post_time) WHERE synced_at IS NULL;
CREATE INDEX notification_event_held_undelivered ON notification_event(post_time) WHERE held = 1 AND delivered_at IS NULL;

-- Ids are deterministic (see the listener issue), so a replayed event is a silent no-op.
insert:
INSERT OR IGNORE INTO notification_event (
    id, key, package_name, app_label, post_time, title, text, big_text, sub_text, channel_id,
    category, flags, importance, event, removed_reason, held, delivered_at, synced_at, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, NULL, NULL, ?);

selectRecent:
SELECT * FROM notification_event
WHERE post_time < :before
ORDER BY post_time DESC
LIMIT :limit;

search:
SELECT * FROM notification_event
WHERE (title LIKE '%' || :q || '%' ESCAPE '\' OR text LIKE '%' || :q || '%' ESCAPE '\' OR big_text LIKE '%' || :q || '%' ESCAPE '\')
  AND (:packageName IS NULL OR package_name = :packageName)
ORDER BY post_time DESC
LIMIT :limit;

selectUnsynced:
SELECT * FROM notification_event
WHERE synced_at IS NULL
ORDER BY post_time ASC
LIMIT :limit;

markSynced:
UPDATE notification_event SET synced_at = :ts WHERE id IN :ids;

selectHeldUndelivered:
SELECT * FROM notification_event
WHERE held = 1 AND delivered_at IS NULL
ORDER BY post_time ASC;

markDelivered:
UPDATE notification_event SET delivered_at = :ts WHERE id IN :ids;

selectHeldBatch:
SELECT * FROM notification_event
WHERE held = 1 AND delivered_at = :deliveredAt
ORDER BY post_time ASC;

-- Retention: never deletes an unsynced row or a held row that has not been delivered yet.
deleteSyncedOlderThan:
DELETE FROM notification_event
WHERE post_time < :ts
  AND synced_at IS NOT NULL
  AND (held = 0 OR delivered_at IS NOT NULL);

changes:
SELECT changes();

countHeld:
SELECT COUNT(*) FROM notification_event WHERE held = 1 AND delivered_at IS NULL;

countUnsynced:
SELECT COUNT(*) FROM notification_event WHERE synced_at IS NULL;

selectApps:
SELECT package_name, MAX(app_label) AS app_label, COUNT(*) AS count, MAX(post_time) AS last_seen
FROM notification_event
GROUP BY package_name
ORDER BY last_seen DESC;
